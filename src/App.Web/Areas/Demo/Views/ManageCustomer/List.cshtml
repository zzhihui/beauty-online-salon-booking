    $('.addCredit').click(function () {
        var baseUrl = "/ManageShop/UpdateUserCredit";
        $(this).prop('disabled', true);
        var addCreditButton = this;
        //alert($(addCreditButton).parent().parent().find('.customerId').text());
        //ajax call to confirm booking
        $.post(
            serverConfig.url + baseUrl,
            {
                customerId: $(addCreditButton).parent().parent().find('.customerId').text(),
                shopId: serverConfig.shopId,
                credits: $(addCreditButton).parent().find('.creditDropdown').val()
            }
        ).done(function (data) {
            console.log(data);
            $(addCreditButton).parent().parent().find('.credit').text(data["Content"]);
            $("#resultMessage").text("Credit Updated");
            //$(addCreditButton).prop('disabled', true);
            $(addCreditButton).removeAttr('disabled');

            //$(addCreditButton).css('display', 'none');
            //$(addCreditButton).parent().parent().find('.rejectButton').css('display', 'none');
        });
    });

