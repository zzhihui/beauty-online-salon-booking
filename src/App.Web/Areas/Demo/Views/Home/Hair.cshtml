    <div class="well row">
        <h5>Quick book or browse services in details below</h5>
        <select name="serviceSelect" id="serviceSelect" ng-model="serviceSelect">
            <option ng-selected="bookingItem.id==serviceSelect" ng-repeat="bookingItem in bookingItems" value="{{bookingItem.id}}">{{bookingItem.name}}</option>
        </select>

        <button style="margin-left: 20px;" ng-disabled="!userloggedin" class="btn btn-default" data-target="#dateTimeModal" ng-click="showDateTime(serviceSelect, -1);">Book</button>
    </div>

    <!--<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#dateTimeModal">
            Launch demo modal
        </button>-->

    @Html.Partial("_ServiceList")

    <div class="modal fade no-left-padding" id="dateTimeModal" tabindex="-1" style="padding-right: 0; overflow: hidden;" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Please select date and time for your<br/>{{bookingTitle}}</h5>
                </div>
                <div class="modal-body">
                    <div class="well row">
                        <div class="form-group">
                            <div ng-show="bookSuccess" class="text-success">{{resultMessage}}</div>
                            <div ng-show="errorOccurs" class="alert alert-danger">{{error}}</div>
                        </div>

                        <div class="form-group">
                            <input class="date" type="text" readonly="readonly" ng-class="showCalendar" ng-model="bookingTime" placeholder="Date time picker">
                            <span><i class="glyphicon glyphicon-calendar"></i></span>
                        </div>

                        <div class="form-group" ng-show="dateSelected">
                            <p>
                                <a ng-repeat="category in availableSlots" id="{{$index}}" class="btn btn-info btn-time" href="" ng-click="setTime($event, category);">
                                    {{category}}
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" ng-click="quickBook();" ng-disabled="!enableBooking">Book</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div>


