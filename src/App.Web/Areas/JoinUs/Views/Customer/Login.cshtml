<div class="well">
    <form name="loginForm" class="form-horizontal" method="post" ng-controller="loginController">
        <fieldset>
            <legend>Login</legend>
            <div class="list-group-item">
                <a class="btn btn-primary" href="#!/register">Register Account</a>
            </div>
            <div ng-show="error" class="alert alert-danger">{{error}}</div>

            <div class="list-group">

                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Email:</label>
                        <div class="col-lg-10" ng-class="{ 'has-error' : loginForm.email.$invalid}">
                            <input type="email" name="email" placeholder="Email" required ng-model="email" ng-minlength="3" maxlength="50" class="form-control">
                            <p ng-show="loginForm.email.$invalid && !loginForm.email.$pristine" class="help-block">Please enter valid email</p>
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="form-group">
                        <label class="col-lg-2 control-label">Password:</label>
                        <div class="col-lg-10" ng-class="{ 'has-error' : loginForm.password.$invalid}">
                            <input type="password" name="password" placeholder="Password" required ng-model="password" ng-minlength="3" maxlength="50" class="form-control">
                            <p ng-show="loginForm.password.$invalid && !loginForm.password.$pristine" class="help-block">Please enter your password</p>
                        </div>
                    </div>
                </div>

                <div class="list-group-item">
                    <div class="form-group">
                        <div class="col-lg-2 col-lg-offset-2">
                            <button type="submit" class="btn btn-primary" ng-click="login()" ng-disabled="!loginForm.$valid">Login</button>
                        </div>
                        <div class="col-lg-2">
                            <a class="btn" href="#!/forgetpassword">Forget password?</a>
                        </div>
                    </div>    
                </div>
            </div>
        </fieldset>
    </form>
</div>