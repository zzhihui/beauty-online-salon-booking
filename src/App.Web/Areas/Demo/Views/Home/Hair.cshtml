                            //    };
                            case 8:
                                return false;
                            //case 31:
                            //    return { classes: "green" };
                        }

                    //if (date.getMonth() == (new Date()).getMonth()) {
                    //    date.getDate.forEach(function (item, index) {
                    //        if (item < 20)
                    //            return false;
                    //    });
                    //}

                },
                changeDate: function () {
                    //var selectedDate= new Date($('#datetimepicker').val())
                    alert("wocao");
                },
                changeMonth: function () {
                    //var selectedDate= new Date($('#datetimepicker').val())
                    alert("wocao");
                }
            }).on("show", function() {//use on events.
                
                $(".day").removeClass("active");
            });
        });

    </script>

