                    console.log(data.appointment.resourceId);
                    var img = "<img style='top: 2px; position: relative;' src='../../../../Content/scheduler/images/person.png'/>";
                    if (data.appointment.resourceId == "Peng") {
                        img = "<img style='top: 2px; position: relative;' src='../../../../Content/scheduler/images/woman.png'/>";
                    }
                    else if (data.appointment.resourceId == "Zhihui") {
                        img = "<img style='top: 2px; position: relative;' src='../../../../Content/scheduler/images/boss.png'/>";
                    }
                    else if (data.appointment.subject == "Antony") {
                        img = "<img style='top: 2px; position: relative;' src='../../../../Content/scheduler/images/oldboss.png'/>";
                    }
                    else if (data.appointment.subject == "John") {
                        img = "<img style='top: 2px; position: relative;' src='../../../../Content/scheduler/images/asian.png'/>";
                    }

                    if (data.view == "weekView" || data.view == "dayView" || data.view == "monthView") {
                        data.html =  img + "<i>" + data.appointment.subject + "</i>";
                        if (data.appointment.id == "id1") {
                            data.style = "#AA4643";
                        }
                        else if (data.appointment.id == "id2" || data.appointment.id == "id6") {
                            data.style = "#309B46";
                        }
                        else if (data.appointment.id == "id3") {
                            data.style = "#447F6E";
                        }
                    }

                    return data;
