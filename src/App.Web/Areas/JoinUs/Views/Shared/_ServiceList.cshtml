<style>
    td{vertical-align: middle !important;}
</style>
<div>
    <div class="well row">
        <h4>
            Cut. Re-Style
        </h4>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Category</th>
                <th>Price From</th>
                <th>Price To</th>
                <th>Stylist</th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat="bookingItem in bookingItems| filter:cutFilter">
                <td>{{$index+1}}</td>
                <td style="display: none;">{{bookingItem.id}}</td>
                <td>{{bookingItem.name}}</td>
                <td>{{bookingItem.description}}</td>
                <td>{{bookingItem.category}}</td>
                <td>{{bookingItem.priceFrom | currency:"€"}}</td>
                <td>{{bookingItem.priceTo | currency:"€"}}</td>
                <td>
                    <select name="serviceUserSelect" id="serviceUserSelect" ng-model="serviceUser" style="color: black;">
                        <option value="-1">Any</option>
                        <option ng-repeat="user in bookingItem.serviceUsers" value="{{user.id}}">{{user.displayName}}</option>
                    </select>
                </td>
                <td ng-show="bookable"><button class="btn btn-default" ng-click="book(bookingItem.id, serviceUser);">Book</button></td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="well row">
        <h4>
            Colour Services
        </h4>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Category</th>
                <th>Price From</th>
                <th>Price To</th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat="bookingItem in bookingItems| filter:{category:'Colour'}">
                <td>{{$index+1}}</td>
                <td>{{bookingItem.name}}</td>
                <td>{{bookingItem.description}}</td>
                <td>{{bookingItem.category}}</td>
                <td>{{bookingItem.priceFrom | currency:"€"}}</td>
                <td>{{bookingItem.priceTo | currency:"€"}}</td>
                <td ng-show="bookable"><button class="btn btn-default" ng-click="book(bookingItem.id);">Book</button></td>
            </tr>
            </tbody>
        </table>
    </div>
</div>


    
