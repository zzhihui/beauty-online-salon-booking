@using App.Web.Application.Extension
@using App.Web.ViewModels
@model CustomerViewModel
@{
    ViewBag.Title = "Admin";
    Layout = Html.Shared("_LayoutAdmin.cshtml");
}

<h2>Admin Portal</h2>

<p id="resultMessage"></p>
<table class="table table-striped">
    <thead>
    <tr>
        <th>#</th>
        <th>Id</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        @*<th>Bookings</th>
        <th>Vouchers</th>*@
        <th>Credits</th>
        <th>Created</th>
        <th>Updated</th>
        <th>Voucher Option</th>
        <th>Credit Option</th>
        <th>Edit User</th>
    </tr>
    </thead>
    <tbody>
    @{ int counter = 1; }
    @foreach (var customer in Model.Customers)
    {
        <tr>
            <td>@(counter++)</td>
            <td class="customerId">@customer.Id</td>
            <td>@customer.FirstName &nbsp; @customer.LastName</td>
            <td>@customer.MobileNumber</td>
            <td>@customer.Email</td>
            @*<td>
                @if (customer.BookingHistory != null && customer.BookingHistory.Any())
                {
                    <ul>
                        @foreach (var booking in customer.BookingHistory)
                        {
                            <li>
                                @booking.Status
                            </li>
                            <li>
                                @booking.ServiceName
                            </li>
                            <li>
                                @booking.DateTimeSlot
                            </li>
                        }
                    </ul>
                }
            </td>
            <td class="voucher"></td>*@
            <td class="credit">@customer.StoreCredit</td>
            <td>@customer.Created</td>
            <td>@customer.Updated</td>
            <td>
                @*Voucher Dropdown*@
                @if (Model.VoucherTypes == null || Model.VoucherTypes.Count == 0)
                {
                    @Html.Label("No voucher available")
                }
                else
                {
                    <select class="voucherDropdown" style="color: black">
                        @foreach (var voucherType in Model.VoucherTypes)
                        {
                            <option value="@voucherType.Id">@voucherType.Name - @voucherType.Desc</option>
                        }
                    </select>
                }
                
                @*@if (customer.IsActive == true)
                {*@
                    <button class="btn btn-default sendVoucher">Send Voucher</button>
                    @*<button class="btn btn-default revokeVoucher">Revoke Voucher</button>*@
                @*}*@
            </td>
            <td>
                @*Credit Dropdown*@
                @*<select class="creditDropdown" style="color: black">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="15">15</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                    <option value="40">40</option>
                    <option value="50">50</option>
                </select>*@
                <input type="number" class="creditDropdown" style="color: black" value="10" min="-100" max="100"/>
                @*@if (customer.IsActive == true)
                {*@
                    <button class="btn btn-default addCredit">Update(+/-) Credits</button>
                    @*<button class="btn btn-default removeCredit">Remove Credit</button>*@
                @*}*@
            </td>
            <td><a href="Edit/@customer.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>

