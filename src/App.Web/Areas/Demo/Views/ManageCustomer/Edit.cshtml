@using App.Web.Application.Extension
@using Glimpse.Mvc.Message
@model App.Service.Contract.Entities.Authentication.WsShopCustomer
@{
    ViewBag.Title = "Admin";
    Layout = Html.Shared("_LayoutAdmin.cshtml");
}
<div class="form-group">
    <a class="btn btn-primary" href="../List">Back</a>
</div>

@ViewBag.result

<form class="form-horizontal" method="POST">
    <fieldset>
        <div class="list-group-item">
            <div class="form-group">
                <label class="col-lg-2 control-label">
                    @Html.LabelFor(x => x.FirstName)
                </label>
                <div class="col-lg-10">
                    @Html.EditorFor(x => x.FirstName)
                </div>
            </div>
        </div>

        <div class="list-group-item">
            <div class="form-group">
                <label class="col-lg-2 control-label">
                    @Html.LabelFor(x => x.LastName)
                </label>
                <div class="col-lg-10">
                    @Html.EditorFor(x => x.LastName)
                </div>
            </div>
        </div>

        <div class="list-group-item">
            <div class="form-group">
                <label class="col-lg-2 control-label">
                    @Html.LabelFor(x => x.Email)
                </label>
                <div class="col-lg-10">
                    @Html.EditorFor(x => x.Email)
                </div>
            </div>
        </div>

        <div class="list-group-item">
            <div class="form-group">
                <label class="col-lg-2 control-label">
                    @Html.LabelFor(x => x.PhoneNumber)
                </label>
                <div class="col-lg-10">
                    @Html.EditorFor(x => x.PhoneNumber)
                </div>
            </div>
        </div>

        <div class="list-group-item">
            <div class="form-group">
                <div class="col-lg-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>

    </fieldset>
</form>