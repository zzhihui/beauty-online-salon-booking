@using System.Reflection
@using App.Web.Application.Extension
@using App.Web.Controllers
@{
    //Localisation
    ViewBag.Title = "Welcome to Beauty Fairy Demo";
}

<style>
    .no-underline:hover,
    .no-underline:focus {
        text-decoration: none;
    }
</style>

@*Localisation*@
<link href="~/Areas/Demo/Content/Style.min.css" rel="stylesheet" />

<div class="navbar navbar-inverse navbar-fixed-top" ng-controller="navController">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#navbar">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            @*TODO:Localisation*@

            @*<span class="mbr-brand__logo"><a href="#!/"><img style="width: 20px; height: 20px;" class="mbr-navbar__brand-img mbr-brand__logo" src="@Html.Content("golden-fairy.png")" alt="Beauty Fairy"></a></span>
        <span class="mbr-brand__name"><a class="mbr-brand__name text-white" href="#!/">Beauty Fairy</a></span>*@
                <a href="#!/"  class="no-underline">
                    <img class="navbar-brand" src="@Html.Content("golden-fairy.png")" alt="Beauty Fairy">
                    <span style="line-height: 50px; color: #888888;">Beauty Demo</span> 
                </a>
        </div>
        <div id="navbar" class="navbar-collapse collapse">

            <ul ng-cloak class="nav navbar-nav">
                <li><a href="#!/"><strong>HOME</strong></a></li>
                <li class="dropdown">
                    <a href="" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true"><strong>SERVICES</strong><span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        <li><a href="#!/hair"><strong>HAIR</strong></a></li>
                        <li><a href="#!/nail"><strong>NAIL</strong></a></li>
                    </ul>
                </li>
                <li><a href="#!/gallery"><strong>GALLERY</strong></a></li>
                <li><a href="#!/about"><strong>ABOUT</strong></a></li>
                <li><a href="#!/contact"><strong>CONTACT</strong></a></li>
                <li><a href="#!/register" ng-hide="userloggedin"><span class="text-danger"><strong>Register</strong></span></a></li>
                <li>&nbsp;</li>
                <li><a href="#!/login" ng-hide="userloggedin"><span class="text-danger"><strong>Login</strong></span></a></li>
                <li>&nbsp;</li>
                @*<li><a href="#!/me" ng-show="userloggedin"><span class="text-danger"><strong>Hello, {{fullName}}</strong></span></a></li>*@

                <li class="dropdown">
                    <a href="" class="dropdown-toggle" ng-show="userloggedin" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="true"><span class="text-danger"><strong>Hello, {{fullName}}</strong></span> <span class="caret"></span></a>
                    <ul class="dropdown-menu">
                        <li><a href="#!/me"><strong>My Account</strong></a></li>
                        <li><a href="#!/bookings"><strong>My Bookings</strong></a></li>
                    </ul>
                </li>

                <li>&nbsp;</li>
                <li><a href="#!/logout" ng-show="userloggedin"><span class="text-danger"><strong>LogOut</strong></span></a></li>
            </ul>
        </div>
    </div>
    <div id="spinner" ng-show="busy" style="margin: 0px; padding: 0px; position: fixed; right: 0px; top: 0px; width: 100%; height: 100%; background-color: #666666; z-index: 30001; opacity: .8; filter: alpha(opacity=70);">
        <p style="position: absolute; top: 30%; left: 45%; color: White;">
            loading...<img src="@Url.Content("~/Content/loading.gif")" style="width: 100px; height: 100px;">
        </p>
    </div>
</div>

<div class="container">
    <br />
    <div ng-view>

    </div>
    <hr>
    <footer>
        @*Localisation*@
        <p class="col-sm-8 col-sm-offset-2">&copy; @DateTime.Now.Year - www.beautyfairy.ie Ver:@Assembly.GetAssembly(typeof(HomeController)).GetName().Version.ToString()</p>
    </footer>
</div>

@section scripts {
    @*Localisation*@
    <script src="@Url.Content("~/Areas/Demo/Scripts/app.js")" type="text/javascript"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $(".navbar-nav li:not(.dropdown) a").click(function (event) {
                $(".navbar-collapse").collapse('hide');
            });
        });
    </script>

}