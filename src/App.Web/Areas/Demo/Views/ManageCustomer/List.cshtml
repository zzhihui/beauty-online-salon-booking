    $('.sendVoucher').click(function () {

        var baseUrl = "/ManageShop/SendUserVoucher";

        var sendVoucherButton = this;

        //ajax call to confirm booking
        $.post(
            serverConfig.url + baseUrl,
            {
                customerId: $(sendVoucherButton).parent().parent().find('.customerId').text(),
                shopId: serverConfig.shopId,
                voucherId: $(sendVoucherButton).parent().find('.voucherDropdown').val()
            }
        ).done(function (data) {
            console.log(data);
            //$(sendVoucherButton).parent().parent().find('.bookingStatus').text(data["Content"]);
            //TODO: voucher list refresh, not in phase 1.
            $(sendVoucherButton).parent().parent().find('.voucher').text(data["Content"]);
