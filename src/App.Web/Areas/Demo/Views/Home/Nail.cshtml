@*<link rel="stylesheet" type="text/css" href="../../../../Content/datepicker/jquery.datetimepicker.css" />*@
<div ng-controller="serviceListController">
    @Html.Partial("_LoginPrompt")
    <h5>
        Select a date and time for your service
    </h5>

    <div class="form-group">
        <div ng-hide="errorOccurs" class="text-success">{{resultMessage}}</div>
        <div ng-show="errorOccurs" class="alert alert-danger">{{error}}</div>
    </div>

    <div class="well row">
        <div class="form-group">
            <input type="text" id="datetimepicker_dark" disabled="disabled" ng-class="showCalendar" ng-model="bookingTime" placeholder="Date time picker">
            <span class="glyphicon glyphicon-calendar"></span>
        </div>
    </div>

    <div class="well row">
        <h4>Quick Book</h4>
        <select name="serviceSelect" id="serviceSelect" ng-model="serviceSelect">
            <option ng-repeat="bookingItem in bookingItems | filter:{category:'Nail'}" value="{{bookingItem.id}}">{{bookingItem.name}}</option>
        </select>

        <button style="margin-left: 20px;" class="btn btn-default" ng-click="quickBook();">Book</button>
    </div>

    <style>
        td {
            vertical-align: middle !important;
        }
    </style>
    <div>
        <div class="well row">
            <h4>
                Colour Services
            </h4>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Price From</th>
                        <th>Price To</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="bookingItem in bookingItems| filter:{category:'Nail'}">
                        <td>{{$index+1}}</td>
                        <td>{{bookingItem.name}}</td>
                        <td>{{bookingItem.description}}</td>
                        <td>{{bookingItem.category}}</td>
                        <td>{{bookingItem.priceFrom | currency:"€"}}</td>
                        <td>{{bookingItem.priceTo | currency:"€"}}</td>
                        <td ng-show="bookable"><button class="btn btn-default" ng-click="book(bookingItem.id);">Book</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>